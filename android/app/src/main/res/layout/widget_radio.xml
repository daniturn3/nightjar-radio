<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="12dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:id="@+id/w_open" android:layout_width="40dp" android:layout_height="40dp" android:src="@mipmap/ic_launcher" android:contentDescription="Open Nightjar Radio" />
        <LinearLayout android:id="@+id/w_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
            <TextView android:id="@+id/w_station" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nightjar Radio" android:textColor="#F3ECDF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_song" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap a preset to tune in" android:textColor="#B0B4C4" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <ImageButton android:id="@+id/w_prev" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_prev" android:background="@android:color/transparent" android:contentDescription="Previous station" />
        <ImageButton android:id="@+id/w_play" android:layout_width="46dp" android:layout_height="46dp" android:layout_marginStart="2dp" android:layout_marginEnd="2dp" android:src="@drawable/ic_play" android:background="@drawable/play_bg" android:contentDescription="Play or pause" />
        <ImageButton android:id="@+id/w_next" android:layout_width="38dp" android:layout_height="38dp" android:src="@drawable/ic_next" android:background="@android:color/transparent" android:contentDescription="Next station" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="34dp" android:layout_marginTop="8dp" android:orientation="horizontal">
        <TextView android:id="@+id/w_p1" style="@style/WPre" /><TextView android:id="@+id/w_p2" style="@style/WPre" /><TextView android:id="@+id/w_p3" style="@style/WPre" />
        <TextView android:id="@+id/w_p4" style="@style/WPre" /><TextView android:id="@+id/w_p5" style="@style/WPre" /><TextView android:id="@+id/w_p6" style="@style/WPre" />
    </LinearLayout>
</LinearLayout>
