<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_bg" android:paddingStart="8dp" android:paddingEnd="8dp">
    <ImageView android:id="@+id/w_logo" android:layout_width="44dp" android:layout_height="44dp" android:scaleType="fitCenter" android:src="@mipmap/ic_launcher" android:contentDescription="Station logo" />
    <LinearLayout android:id="@+id/w_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="10dp">
        <TextView android:id="@+id/w_station" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Nightjar Radio" android:textColor="#F3ECDF" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_song" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Tap play to tune in" android:textColor="#B0B4C4" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <ImageButton android:id="@+id/w_play" android:layout_width="44dp" android:layout_height="44dp" android:src="@drawable/ic_play" android:background="@drawable/play_bg" android:contentDescription="Play or pause" />
    <ImageButton android:id="@+id/w_next" android:layout_width="40dp" android:layout_height="40dp" android:src="@drawable/ic_next" android:background="@android:color/transparent" android:contentDescription="Next station" />
</LinearLayout>
